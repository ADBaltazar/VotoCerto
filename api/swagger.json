{
    "openapi":"3.0.0",
    "info":{
        "title":"API de eleições online para Presidencia de Angola",
        "description":"API do Sistema Integrado de Gestão do Processo Eleitoral foi desenvolvido com base em uma arquitetura moderna, segura e escalável, destinada a apoiar todas as fases das Eleições Gerais em Angola, em conformidade com a legislação eleitoral vigente",
        "termsOfService":"http:localhost:3000/terms",
        "contact":{
            "email":"armandobaltazar38@gmail"
        },
        "version":"1.0.0"  
    },
    "servers":[
        { 
            "url":"http://localhost:3000",
            "description":"API de teste"
        }
    ],
    "paths":{ 
        "/provincia/nova":{
            "post":{
                "sumary":"Cadastro de nova provincia",
                "description":"Rota de Cadastro de nova provincia",
                "tags":["provincia"],

                "requestBody":{
                    "content":{
                        "application/json":{
                            "schema":{
                                "$ref":"#/components/schemas/provincia"
                            },
                            "examples":{
                                "provincia":{
                                    "value":{
                                        "nome":"Uíge"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses":{
                    "201":{
                        "description":"Registo Concluido com sucesso"
                    },
                    "500":{"description":"Erro interno de servidor"}
                }
            }
        },
        "/provincia/actulizar":{
            "put":{
                "sumary":"actualizar provincia",
                "description":"Actualização de dados de uma provincia",
                "tags":["provincia"],
                "requestBody":{
                    "content":{
                        "application/json":{
                            "schema":{
                                "$ref":"#/components/schemas/provincia"
                            },
                            "examples":{
                                "provincia":{
                                    "value":{
                                            "nome":"Luanda Tarde",
                                            "id_provincia":1
                                    }
                                }
                            }
                        }
                    }
                },
                "responses":{
                    "201":{
                        "description":"Ok ✅ "
                    }
                }

            }
        },
        "/provincias":{
            "get":{
                "tags":["provincia"],
                "sumary":"Lista da Universidades",
                "description":"Esta Rota é responsavel por listar todas as Universidades",
                "responses":{
                    "200":{
                        "description":"Lista das universidades"
                    }
                }
            }
        },

        "/provinciar/municipios":{
            "get":{
                "tags":["provincia"],
                "sumary":"Listar provincias e seus municipios",
                "description":"Esta rota permite retornar as provincias e seus municipios",

                "responses":{
                    "200":{"description":"ok ✅"}
                }
            }
        },

        "/provincia/id":{
            "delete":{
                "tags":["provincia"],
                "sumary":"Elimanar provincia",
                "description":"Esta rota, permitirá excluir uma provincia pelo ID",
            
             "parameters":[
                {
                    "name":"id",
                    "in":"query",
                    "description":"Id da provincia",
                    "required":true
                }
            ],
            "responses":{
                "200":{
                    "description":"Ok ✅ "
                },
                "400":{
                    "description":"Error, registo não encontrado"
                }
            }           
            }

        },

        "/municipio":{
            "post":{
                "tags":["EndPoint - municipio"],
                "sumary":"Rota de cadastro de novo municipio",
                "description":"Esta rota permite o registo de novo municipio",

                "requestBody":{
                    "content":{
                        "application/json":{
                            "schema":{
                                "$ref":"#/components/schemas/municipio"
                            },

                            "examples":{
                                "municipio":{
                                    "value":{
                                        "nome":"Maquela do Zombo",
                                        "provincia_id":1
                                    }
                                }
                            }
                        }
                    }
                },

                "responses":{
                    "200":{
                        "description":"Ok"
                    },
                    "400":{
                        "description":"Duplicação de nome..."
                    }
                }
            }
        },
        "/municipios/lista":{
            "get":{
                "tags":["EndPoint - municipio"],
                "sumary":"Lsitar",
                "description":"Esta rota permite listar os municipios cadastrados no sistema",

                "responses":{
                    "200":{
                        "description":"Ok"
                    },
                    "400":{
                        "description":"Erro, Erro interno do Servidor..."
                    }
                }
            }
        },

        "/municipio/delete/id":{
            "delete":{
                "tags":["EndPoint - municipio"],
                "sumary":"Eliminar",
                "description":"Esta rota permitirá a eliminação de uma registo cadastrado"

                ,"parameters":[
                    {
                        "name":"id",
                        "in":"query",
                        "description":"",
                        "required":true
                    }
                ],
                "responses":{
                    "201":{
                        "description":"✅ Registo Excluido com sucesso!"
                    },
                    "400":{
                        "description":"❌ REgisto não encontrado"
                    }
                }
            }
        }

        
    },
    "components":{
        "schemas":{

            "provincia":{
                "type":"object",
                "properties":{
                    "nome":{"type":"string"}
                }
            },

            "municipio":{
                "type":"object",
                "properties":{
                    "nome":{"type":"string"}
                }
            }

        }
    }
}